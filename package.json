{
  "name": "operations-intelligence-system",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "poc:rls": "tsx poc/rls-poc.ts",
    "poc:imports:check": "node --import tsx poc/import-smoke.ts",
    "poc:api:imports:check": "node --import tsx poc/api-import-smoke.ts",
    "poc:api:acceptance:smoke": "node --import tsx poc/api-acceptance-startup-smoke.ts",
    "poc:api:acceptance:runner:smoke": "OIS_API_ACCEPTANCE_IMPORT_SMOKE=true node --import tsx poc/api-acceptance-runner.ts",
    "poc:phase3b3:api:acceptance:runner:smoke": "OIS_PHASE3B3_API_ACCEPTANCE_IMPORT_SMOKE=true node --import tsx poc/phase3b3-api-acceptance-runner.ts",
    "poc:phase3b4:api:acceptance:runner:smoke": "OIS_PHASE3B4_API_ACCEPTANCE_IMPORT_SMOKE=true node --import tsx poc/phase3b4-api-acceptance-runner.ts",
    "poc:runner:smoke": "OIS_RUNNER_IMPORT_SMOKE=true node --import tsx poc/migration-runner.ts",
    "poc:prisma:generate": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'prisma/**/*.ts' 'poc/**/*.ts' '*.{json,ts,mts,mjs,yml,yaml,css}' '.github/**/*.yml'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:phase3b2:postgres": "node --import tsx poc/phase3b2-postgres-acceptance.ts",
    "test:phase3b2:postgres:smoke": "OIS_PHASE3B2_POSTGRES_IMPORT_SMOKE=true node --import tsx poc/phase3b2-postgres-acceptance.ts",
    "test:phase3c1:postgres": "node --import tsx poc/phase3c1-postgres-acceptance.ts",
    "test:phase3c1:postgres:smoke": "OIS_PHASE3C1_POSTGRES_IMPORT_SMOKE=true node --import tsx poc/phase3c1-postgres-acceptance.ts",
    "test:phase3b4:r2:smoke": "node --import tsx poc/r2-real-smoke.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap:pilot": "tsx prisma/bootstrap-pilot.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.45.1",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "pg": "8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
