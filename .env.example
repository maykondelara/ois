# Public, browser-safe configuration
NEXT_PUBLIC_APP_NAME=Operations Intelligence System

# Server-only application configuration
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-32-byte-development-secret
AUTH_URL=http://localhost:3000

# Local Docker dependencies. Never use these example values in staging or production.
DATABASE_URL=postgresql://ois_local_app:change-me-local-only@localhost:5432/ois_local?schema=public
DIRECT_URL=postgresql://ois_local_migrator:change-me-local-only@localhost:5432/ois_local?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ois-local-private
S3_ACCESS_KEY=ois_local_minio
S3_SECRET_KEY=change-me-local-only

# Optional observability
SENTRY_DSN=
